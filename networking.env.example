# Copy to .networking.local.env; Left out via the .gitignore.
# Check: Board and laptop must be on same 2.4 GHz LAN/hotspot.
# These values are compiled into the experimental Wi-Fi image.
export LEGDAY_WIFI_SSID='your-2.4GHz-SSID'
export LEGDAY_WIFI_PASSWORD='your-WPA2-password'
export LEGDAY_PC_IP='192.168.1.123'
